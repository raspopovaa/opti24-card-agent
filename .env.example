# Скопируйте в ~/.opti24-demo.env (вне репозитория!) и впишите свои значения.
# Параметры DEMO-стенда: спецификация Opti24 API. Файл с настоящими данными в Git не добавляйте.
API_BASE_URL=https://api-demo.opti-24.ru/vip/
API_KEY=your_api_key_here
API_LOGIN=your_login_here
API_PASSWORD=your_password_here
API_REQUESTS_PER_SECOND=1

# Ключ выбранной модели (нужен только один):
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPUAI_API_KEY=
