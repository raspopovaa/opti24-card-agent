# Скопируйте в ~/.opti24-demo.env (вне репозитория!) и впишите свои значения.
# Параметры DEMO-стенда: спецификация Opti24 API. Файл с настоящими данными в Git не добавляйте.
API_BASE_URL=https://api-demo.opti-24.ru/vip/
API_KEY=your_api_key_here
API_LOGIN=your_login_here
API_PASSWORD=your_password_here
API_REQUESTS_PER_SECOND=1

# Ключ выбранной модели (нужен только один). По умолчанию агент работает через Cloud.ru:
# AGENT_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPUAI_API_KEY=

# Значения по умолчанию договора (необязательно): подставляются, если пользователь их не назвал.
# OPTI24_SERVICE_FEE_PERCENT=   # сервисный сбор вашего договора, %, например 3,75
# OPTI24_DEFAULT_PRODUCT=       # вид топлива как в операциях, например ДТ
# OPTI24_DEFAULT_GROUP_ID=      # ID группы карт из list_card_groups
# Повторная сверка чисел инструментом (этап тестирования; тратит тарифицируемые запросы):
# AGENT_VERIFY_ANSWER=on
# Внутренние документы базы знаний (гриф internal) в ответах. По умолчанию выключено:
# включайте, только если агентом пользуются сотрудники компании, а не её клиенты.
# OPTI24_KNOWLEDGE_INTERNAL=1
